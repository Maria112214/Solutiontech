<script>

  let historico = [];

  let ultimaResposta = "";

  const mensagens = document.getElementById("messages");

  function mapa(busca) {

    const url =
      "https://www.google.com/maps/search/" +
      encodeURIComponent(busca);

    window.open(url, "_blank");

  }

  function adicionarMensagem(texto, tipo) {

    const div = document.createElement("div");

    div.className = "message " + tipo;

    div.textContent = texto;

    mensagens.appendChild(div);

    mensagens.scrollTop = mensagens.scrollHeight;

  }

  function perguntarRapido(texto) {

    document.getElementById("userInput").value = texto;

    enviarMensagem();

  }

  async function enviarMensagem() {

    const input = document.getElementById("userInput");

    const pergunta = input.value.trim();

    if (!pergunta) return;

    adicionarMensagem(pergunta, "user");

    input.value = "";

    const carregando = document.createElement("div");

    carregando.className = "message bot";

    carregando.textContent = "Pensando...";

    carregando.id = "carregando";

    mensagens.appendChild(carregando);

    mensagens.scrollTop = mensagens.scrollHeight;

    try {

      const resposta = await fetch("/api/chat", {

        method: "POST",

        headers: {
          "Content-Type": "application/json"
        },

        body: JSON.stringify({
          message: pergunta,
          history: historico
        })

      });

      if (!resposta.ok) {
        throw new Error("Erro no servidor");
      }

      const dados = await resposta.json();

      document.getElementById("carregando")?.remove();

      const texto =
        dados.reply ||
        "Desculpe, não consegui responder agora.";

      adicionarMensagem(texto, "bot");

      ultimaResposta = texto;

      historico.push({
        role: "user",
        content: pergunta
      });

      historico.push({
        role: "assistant",
        content: texto
      });

      if (historico.length > 20) {
        historico = historico.slice(-20);
      }

    } catch (erro) {

      document.getElementById("carregando")?.remove();

      const respostaLocal = respostaLocalIA(pergunta);

      adicionarMensagem(respostaLocal, "bot");

      ultimaResposta = respostaLocal;

    }

  }

  function respostaLocalIA(pergunta) {

    const p = pergunta.toLowerCase();

    if (
      p.includes("emergência") ||
      p.includes("urgência") ||
      p.includes("socorro") ||
      p.includes("passando mal")
    ) {

      return `Se for uma emergência médica, procure atendimento imediatamente.

No Brasil, o SAMU atende pelo número 192.

Se houver risco imediato à vida, procure também uma unidade de emergência.`;

    }

    if (
      p.includes("abrigo") ||
      p.includes("moradia") ||
      p.includes("sem teto") ||
      p.includes("morador de rua")
    ) {

      return `Posso ajudar a encontrar opções de abrigo e assistência social em Maringá.

Você pode procurar no mapa por "abrigo assistência social Maringá Paraná".`;

    }

    if (
      p.includes("comida") ||
      p.includes("alimentação") ||
      p.includes("fome")
    ) {

      return `Se você precisa de alimentação, posso ajudar a encontrar restaurantes populares, instituições e pontos de assistência em Maringá.

Também posso procurar um local próximo pelo mapa.`;

    }

    if (
      p.includes("dentista") ||
      p.includes("dente") ||
      p.includes("odont")
    ) {

      return `Você pode procurar atendimento odontológico em Maringá.

Use o botão de Dentista acima ou pesquise por "dentista odontologia Maringá Paraná" no mapa.`;

    }

    if (
      p.includes("psicólogo") ||
      p.includes("psicologia") ||
      p.includes("ansiedade") ||
      p.includes("depressão")
    ) {

      return `Se você está precisando conversar com um profissional de saúde mental, posso ajudar a encontrar psicologia, CAPS ou outros serviços em Maringá.

Se houver risco imediato de você se machucar ou machucar outra pessoa, procure atendimento de emergência imediatamente.`;

    }

    if (
      p.includes("remédio") ||
      p.includes("medicamento") ||
      p.includes("farmácia")
    ) {

      return `Posso ajudar você a encontrar farmácias e serviços de medicamentos em Maringá.

Também posso orientar sobre onde procurar atendimento de saúde para verificar a necessidade de um medicamento.`;

    }

    return `Posso conversar sobre esse assunto, mas neste momento estou sem conexão com o servidor de IA.

Tente novamente em alguns segundos.

Se você estiver procurando ajuda em Maringá, também posso ajudar com:
• Saúde
• Abrigo
• Alimentação
• Medicamentos
• Dentista
• Exames
• Documentos
• Saúde mental`;

  }

  function falar(texto) {

    if (!("speechSynthesis" in window)) {

      alert("Seu navegador não possui suporte para leitura de voz.");

      return;

    }

    speechSynthesis.cancel();

    const fala = new SpeechSynthesisUtterance(texto);

    fala.lang = "pt-BR";

    fala.rate = 0.95;

    fala.pitch = 1;

    speechSynthesis.speak(fala);

  }

  function falarUltimaResposta() {

    if (!ultimaResposta) {

      falar(
        "Olá! Eu sou o assistente do Peça Ajuda. Como posso ajudar?"
      );

      return;

    }

    falar(ultimaResposta);

  }

</script>

