<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Peça Ajuda | Solution Tech</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background: #f5f7fa;
      color: #172033;
    }

    header {
      background: #ffffff;
      border-bottom: 1px solid #e5e7eb;
      padding: 18px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .logo {
      font-size: 27px;
      font-weight: 800;
      color: #d71920;
    }

    nav a {
      text-decoration: none;
      color: #172033;
      margin-left: 25px;
      font-weight: 600;
    }

    nav a:hover {
      color: #d71920;
    }

    .hero {
      min-height: 600px;
      padding: 70px 7%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 50px;
      background: linear-gradient(135deg, #ffffff, #eef3f8);
    }

    .hero-text {
      max-width: 650px;
    }

    .tag {
      display: inline-block;
      background: #fee2e2;
      color: #b91c1c;
      padding: 8px 15px;
      border-radius: 30px;
      font-weight: bold;
      margin-bottom: 20px;
    }

    h1 {
      font-size: 56px;
      line-height: 1.05;
      margin-bottom: 22px;
    }

    h1 span {
      color: #d71920;
    }

    .hero-text p {
      font-size: 20px;
      line-height: 1.6;
      color: #5b6474;
      margin-bottom: 30px;
    }

    .buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    button {
      border: none;
      cursor: pointer;
    }

    .primary {
      background: #d71920;
      color: white;
      padding: 15px 24px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: bold;
    }

    .primary:hover {
      background: #b91c1c;
    }

    .secondary {
      background: white;
      color: #172033;
      border: 1px solid #d5d9df;
      padding: 15px 24px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: bold;
    }

    .robot-area {
      width: 330px;
      height: 330px;
      background: white;
      border-radius: 35px;
      box-shadow: 0 20px 50px rgba(0,0,0,.12);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .robot {
      font-size: 110px;
      margin-bottom: 10px;
    }

    .robot-area strong {
      font-size: 21px;
    }

    .robot-area small {
      margin-top: 7px;
      color: #687386;
    }

    section {
      padding: 70px 7%;
    }

    .section-title {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 45px;
    }

    .section-title h2 {
      font-size: 38px;
      margin-bottom: 12px;
    }

    .section-title p {
      color: #687386;
      line-height: 1.6;
    }

    .credit {
      text-align: center;
      margin: -25px auto 45px;
      color: #687386;
    }

    .credit strong {
      color: #d71920;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .step {
      background: white;
      padding: 30px;
      border-radius: 18px;
      text-align: center;
      box-shadow: 0 8px 25px rgba(0,0,0,.06);
    }

    .step-number {
      width: 55px;
      height: 55px;
      margin: auto auto 18px;
      border-radius: 50%;
      background: #d71920;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      font-weight: bold;
    }

    .step h3 {
      margin-bottom: 10px;
    }

    .step p {
      color: #687386;
      line-height: 1.5;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 18px;
      padding: 25px;
      transition: .2s;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(0,0,0,.08);
    }

    .icon {
      font-size: 38px;
      margin-bottom: 15px;
    }

    .card h3 {
      margin-bottom: 9px;
    }

    .card p {
      color: #687386;
      line-height: 1.5;
      font-size: 14px;
      margin-bottom: 15px;
    }

    .map-button {
      width: 100%;
      padding: 11px;
      border-radius: 8px;
      background: #172033;
      color: white;
      font-weight: bold;
    }

    .map-button:hover {
      background: #d71920;
    }

    .chat-section {
      background: #111827;
      color: white;
    }

    .chat-section .section-title p {
      color: #b9c1ce;
    }

    .chat-container {
      max-width: 850px;
      margin: auto;
      background: white;
      border-radius: 22px;
      overflow: hidden;
      color: #172033;
      box-shadow: 0 20px 60px rgba(0,0,0,.25);
    }

    .chat-header {
      background: #d71920;
      color: white;
      padding: 20px;
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .chat-header .mini-robot {
      font-size: 40px;
    }

    .chat-header h3 {
      margin-bottom: 3px;
    }

    .chat-header small {
      opacity: .85;
    }

    .messages {
      height: 430px;
      padding: 20px;
      overflow-y: auto;
      background: #f7f8fa;
    }

    .message {
      max-width: 80%;
      padding: 13px 16px;
      border-radius: 15px;
      margin-bottom: 12px;
      line-height: 1.5;
      white-space: pre-wrap;
    }

    .bot {
      background: white;
      border: 1px solid #e5e7eb;
      margin-right: auto;
    }

    .user {
      background: #d71920;
      color: white;
      margin-left: auto;
    }

    .quick-buttons {
      padding: 12px 18px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      border-top: 1px solid #e5e7eb;
    }

    .quick-buttons button {
