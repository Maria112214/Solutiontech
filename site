      padding: 14px;
      border: 1px solid #d5d9df;
      border-radius: 10px;
      outline: none;
      font-size: 15px;
    }

    .chat-input input:focus {
      border-color: #d71920;
    }

    .send {
      background: #d71920;
      color: white;
      padding: 0 20px;
      border-radius: 10px;
      font-weight: bold;
    }

    .voice-button {
      background: #172033;
      color: white;
      padding: 10px 15px;
      border-radius: 10px;
      margin-left: auto;
    }

    .help-box {
